  var documents=[row.Numero_OP].concat(plan.target?[plan.target.Numero_OP]:[]).map(function(op,i){return {ID_Documento:slot.Archivo_ID+(i?'-DESTINO':''),Tipo_Documento:'AJUSTE',Numero_Relacionado:op,Cedula_NIT:i?plan.target.Cedula_NIT:row.Cedula_NIT,Nombre_Cliente:i?plan.target.Nombre_Cliente:row.Nombre_Cliente,Nombre_Archivo:slot.Nombre,File_ID:slot.File_ID,Mime_Type:slot.Mime_Type,Version:1,Activo:'NO',Fecha_Registro:stamp,Operador:s.profile.uid,Request_ID:requestId};});
