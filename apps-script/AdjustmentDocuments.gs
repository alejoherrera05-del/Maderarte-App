function ajDocumentAccess_(number,context){var s=ajSession_(context,false),r=mdUnique_(listRows_('Anulaciones'),'Anulacion_ID',number);if(!r||r.Tipo_Entidad!=='AJUSTE_OP'||r.Estado!=='CONFIRMADA')throw appError_('ADJUSTMENT_NOT_FOUND','No se encontró el ajuste.',404);var e=parseJson_(r.Consecuencias_JSON,null),source=findRow_('Ordenes_Pedido','Numero_OP',r.Entidad_ID),target=e&&e.target?findRow_('Ordenes_Pedido','Numero_OP',e.target):null;if(!source||(!orderBranchReadable_(s,source.Sede)||(target&&!orderBranchReadable_(s,target.Sede))))throw appError_('BRANCH_NOT_ALLOWED','No tienes acceso a este ajuste.',403);var slot=mdUnique_(mdRows_(r.Entidad_ID),'Archivo_ID',number+'-PDF-V1');if(!slot)throw appError_('DOCUMENT_NOT_PLANNED','Falta el documento reservado del ajuste.',409);return {slot:slot};}
